[Unit]
Description=OAuth2 Mail Manager (Outlook/Gmail batch mail manager)
After=network.target

[Service]
Type=simple
# 按实际部署路径与用户名修改
User=root
WorkingDirectory=/opt/outlook-mail-manager
ExecStart=/opt/outlook-mail-manager/venv/bin/python app.py
Restart=on-failure
RestartSec=5

# ── 可选环境变量 ──
# 初始管理员密码（仅首次建库时生效，之后以库内为准，界面可改）
#Environment=OMM_ADMIN_PASSWORD=please-change-me
# 全局中转代理（单账号代理可在 Web 设置页单独指定，优先于此）
#Environment=OMM_PROXY=socks5://user:pass@127.0.0.1:1080
# 新导入 MS 账号默认取件方式：graph（推荐，默认）或 imap
#Environment=OMM_MS_FETCH_MODE=graph
# 监听端口（默认 8899）
#Environment=OMM_PORT=8899
# 数据库路径（默认程序目录下 data.db）
#Environment=OMM_DB_PATH=/opt/outlook-mail-manager/data.db

[Install]
WantedBy=multi-user.target
