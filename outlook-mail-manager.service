[Unit]
Description=OAuth2 Mail Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=outlook-mail-manager
Group=outlook-mail-manager
WorkingDirectory=/opt/outlook-mail-manager
ExecStart=/usr/bin/python3 /opt/outlook-mail-manager/launcher.py
Restart=always
RestartSec=5
UMask=0077

Environment=OMM_DB_PATH=/var/lib/outlook-mail-manager/data.db
Environment=OMM_SECRET_KEY_FILE=/var/lib/outlook-mail-manager/secret.key
Environment=OMM_SECURE_COOKIE=1
Environment=OMM_HOST=127.0.0.1
Environment=OMM_PORT=8899
EnvironmentFile=-/etc/outlook-mail-manager/env

StateDirectory=outlook-mail-manager
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/outlook-mail-manager /var/lib/outlook-mail-manager

[Install]
WantedBy=multi-user.target
